rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in [
          'mntzralghanm527@gmail.com', 
          'mntzr.alghanm527@gmail.com',
          'mntzralghanm527@googlemail.com',
          'mntzr.alghanm527@googlemail.com',
          'abdulradhaalmayali@gmail.com'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin-boys' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin-girls' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'manager' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin'
        ))
      ); 
    }

    function isStudentOrParentDoc(studentCode) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentCode', '') == studentCode || 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('parentCode', '') == studentCode
             );
    }

    // Validation helpers
    function isValidFinance(data) {
      return data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 100;
    }

    function isValidPayment(data) {
      return data.amount is number && 
             data.studentCode is string && 
             data.transactionId is string && 
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    function isValidRecordedLesson(data) {
      return data.schoolId is string && data.schoolId.size() > 0 && data.schoolId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100;
    }

    function isTeacherOrAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'professor'
        )
      );
    }

    function isValidSchoolFile(data) {
      return data.schoolId is string && data.schoolId.size() > 0 && data.schoolId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
             data.grade is string && data.grade.size() > 0 && data.grade.size() <= 100 &&
             data.tag is string && data.tag.size() > 0 && data.tag.size() <= 100 &&
             data.downloads is number;
    }

    // --- Global Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---

    match /school_configs/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /finance/{financeId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || isStudentOrParentDoc(resource.data.studentCode)));
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || isStudentOrParentDoc(resource.data.studentCode)));
      allow create: if isSignedIn() && isValidPayment(incoming());
      allow update, delete: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();

      match /online_users/{userId} {
        allow read, write: if isSignedIn();
      }
      match /ai_materials/{materialId} {
        allow read: if true;
        allow write: if isTeacherOrAdmin();
      }
      match /activities_submissions/{submissionId} {
        allow read: if isTeacherOrAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn();
        allow update, delete: if isTeacherOrAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    match /academy_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.target == 'all' || resource.data.schoolId != null);
      allow create: if isTeacherOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /school_students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activation_codes/{codeId} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['used', 'usedBy']));
    }

    match /developer_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /system_stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }

    match /teachers/{teacherId} { 
      allow read: if true; 
      allow write: if isAdmin();
    }
    match /parent_requests/{requestId} {
      allow read, write: if isAdmin();
    }
    match /community_posts/{postId} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isSignedIn();
      
      match /admin_notes/{noteId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /comments_list/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || isSignedIn();
      }

      match /reactions_list/{reactionId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
    match /community_stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();

      match /replies_list/{replyId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || isSignedIn();
      }
    }
    match /class_schedules/{scheduleId} { allow read: if true; allow write: if isAdmin(); }
    match /broadcasts/{broadcastId} { allow read: if true; allow write: if isAdmin(); }
    match /global_announcements/{announcementId} { allow read: if true; allow write: if isAdmin(); }
    match /battalions/{battalionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && resource.data.leaderId == request.auth.uid);
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }
    match /academic_lists/{listId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /content/{contentId} { allow read: if true; allow write: if isAdmin(); }
    match /admin_outbox/{outboxId} { allow read, write: if isAdmin(); }
    match /salaries/{salaryId} { allow read, write: if isAdmin(); }
    match /payment_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /parent_receipts/{receiptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /saved_receipts/{receiptId} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    match /idea_bank/{ideaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /council_polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /lounge_messages/{msgId} {
      allow read, write: if isSignedIn();
    }

    match /live_sessions/{sessionId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin(); // Allow teachers/admins to write to start/stop live sessions
      match /responses/{userId} {
        allow read, write: if isSignedIn(); // Allow authenticated students to read/write real-time quiz responses
      }
      match /viewers/{viewerId} {
        allow read, write: if isSignedIn();
      }
      match /webrtc_connections/{connectionId} {
        allow read, write: if isSignedIn();
        match /teacher_candidates/{candidateId} {
          allow read, write: if isTeacherOrAdmin();
        }
        match /student_candidates/{candidateId} {
          allow read, write: if isSignedIn();
        }
      }
    }

    match /exam_papers/{paperId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    match /question_bank/{questionId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    match /social_notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    match /recorded_lessons/{lessonId} {
      allow read: if true;
      allow create: if isTeacherOrAdmin() && isValidRecordedLesson(incoming());
      allow update, delete: if isTeacherOrAdmin();
    }

    match /school_files/{fileId} {
      allow read: if true;
      allow create: if isTeacherOrAdmin() && isValidSchoolFile(incoming());
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['downloads']) && incoming().downloads == existing().downloads + 1)
      );
      allow delete: if isTeacherOrAdmin();
    }

    match /schools/{schoolId}/activities_submissions/{submissionId} {
      allow read, write: if isTeacherOrAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /schools/{schoolId}/ai_materials/{materialId} {
      allow read: if true;
      allow write: if isTeacherOrAdmin();
    }

    match /student_live_notes/{noteId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isStudentOrParentDoc(resource.data.userId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isStudentOrParentDoc(incoming().userId));
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isStudentOrParentDoc(resource.data.userId));
    }

    match /video_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- Transport Collections ---
    match /transport_routes/{routeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    match /transport_drivers/{driverId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transport_students_status/{statusId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    match /transport_fees/{feeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system_errors/{errorId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /bairaq_pose_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bairaq_assets_history/{historyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /school_archives/{archiveId} {
      allow read, write: if isAdmin();
    }
    match /system/{document=**} {
      allow read: if true;
    }
  }
}
