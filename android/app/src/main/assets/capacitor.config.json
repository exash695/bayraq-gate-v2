{
	"appId": "com.bairaq.gate6",
	"appName": "بوابة بيرق - Bayraq Gate",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true,
		"allowNavigation": [
			"bairaq-iq.com",
			"*.bairaq-iq.com",
			"api.bairaq-iq.com"
		]
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"GoogleAuth": {
			"scopes": [
				"profile",
				"email"
			],
			"serverClientId": "728585268376-hf25klmd55cjomn0cuhso6qno10gn977.apps.googleusercontent.com",
			"forceCodeForRefreshToken": true
		}
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#020617"
	}
}
