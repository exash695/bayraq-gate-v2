rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(studentId) { return isSignedIn() && request.auth.uid == studentId; }
    
    // Validation Helpers
    function isValidStudent(data) {
      return data.name is string && data.paidAmount is number;
    }
    
    function isValidPayment(data) {
      return data.amount is number && data.studentId is string && data.status is string;
    }

    // --- Global Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Admins managed elsewhere
    }

    match /students/{studentId} {
      allow read: if isOwner(studentId) || isAdmin();
      allow write: if isAdmin(); // Admin-only updates
    }

    match /payments/{paymentId} {
      // Admins read all, users read own? (Need to link via studentId if allowed)
      allow read: if isAdmin();
      allow write: if isAdmin(); 
      
      // Admin update pattern (example of Tiered logic)
      allow update: if (
        isAdmin() && 
        isValidPayment(request.resource.data)
      );
    }
  }
}
